# Base URL for backend API calls.
# Leave empty in local dev to use the Vite proxy (same-origin, no CORS).
# Set to a full origin (e.g. https://api.example.com) in other environments.
VITE_API_BASE_URL=

# Default live-refresh interval for polling views, in milliseconds.
# Also adjustable at runtime from the header.
VITE_POLL_INTERVAL_MS=10000
